scripts/bench/verify_port/spec.json
scripts/bench/verify_port/ts_result.json
scripts/bench/verify_port/*.rgba
docs/benchmark/run.log

# Forward-pass caches (regenerable; delete to force re-inference)
docs/benchmark/raw_records_*.json

# Test bundles (regenerated by npm pretest)
tests/bundle.mjs
tests/urlguard.bundle.mjs

# Training corpus image bytes (regenerable: scripts/bench/fetch_corpus.py)
